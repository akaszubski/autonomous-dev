#!/bin/bash
#
# Pre-commit hook - Validate repository structure
#
# This hook ensures files are in the correct locations:
# - User docs in plugins/autonomous-dev/docs/
# - Dev docs in docs/
# - No duplicates between root and plugin
# - Clean root directory
#
# To install this hook:
#   ln -sf ../../scripts/hooks/pre-commit .git/hooks/pre-commit
#
# To bypass (emergency only):
#   git commit --no-verify

set -e

echo "🔍 Validating repository structure..."

# Run structure validation
python3 scripts/validate_structure.py

echo "🔍 Checking for accidentally staged .claude/ files..."

# Block every staged .claude/ path except an EXACT, whole-line allowlist of
# (path, staged git object mode) PAIRS.
#
# The key is the pair, not the path alone. `git diff --cached --name-only`
# emits only the LINK PATH for a symlink, so a name-only allowlist permitted
#   ln -s /etc/hosts .claude/settings.json && git add -f .claude/settings.json
# to commit clean: a symlink to anywhere on the filesystem, landing under a
# name Claude Code loads as live configuration (hooks, permissions.allow, MCP
# allow/deny) and that CI parses as JSON. `--raw` carries the NEW mode as its
# second field (`120000` symlink, `100644` regular file); claude_gate_scan
# pairs it with the path so the exact match below is over `<path> <mode>`.
#
# A blanket symlink refusal would be WRONG here: .claude/PROJECT.md is itself
# a symlink by design, and is the allowlist's own first entry. Each path is
# therefore pinned to the one mode it is legitimately tracked at.
#
# Deletions (new mode `000000`) are dropped by the scan and never reach the
# allowlist. A deletion stages no object, so it cannot carry the smuggled
# content this gate exists to refuse; and removing a .claude/ path from
# tracking is the remedy this gate asks for, not something it should refuse.
#
# Matching is exact whole-line against three literal `<path> <mode>` strings.
# The prior form `grep -v "^\.claude/PROJECT.md"` was a PREFIX match with no
# end anchor, so `.claude/PROJECT.md.bak` slipped through, and an entry for
# settings.json written the same way would have permitted
# `.claude/settings.json.bak-20260903-081206`. Exact match closes that class:
# non-matching paths fall through (fail-closed).
#
# THREE GAPS CLOSED 2026-09-04. The form replaced here was, on one line:
#   git diff --cached --raw | awk -F'\t' '...' | grep "^\.claude/" \
#     | grep -vxF -e ... -e ... -e ...  || true
#
# GAP 1 — WHY `-z`. Without it git applies core.quotePath, which is ON by
# default: any path holding a non-ASCII byte, a backslash, a double quote or a
# control character is wrapped in double quotes and C-style-escaped, so it
# arrives with a leading `"` and no longer matches a `^\.claude/` selector.
# `.claude/café-évil.json` therefore left this gate's DOMAIN entirely and
# committed clean with rc=0 — the gate never saw it, so it had nothing to
# refuse. `-z` emits the raw undecoded bytes, NUL-terminated, and never quotes.
# The same trap, with the same reasoning, is written up at
# plugins/autonomous-dev/lib/git_operations.py:466-475.
#
# GAP 2 — WHY THE SELECTOR FOLDS CASE BUT THE ALLOWLIST DOES NOT. The old
# selector was byte-exact while APFS folds case, so `.Claude/settings.json`
# was not selected and committed clean with rc=0. The SELECTOR now folds —
# `.[Cc][Ll][Aa][Uu][Dd][Ee]/*` — which WIDENS the gate's domain. The
# ALLOWLIST stays byte-exact, so `.claude/SETTINGS.JSON` is now selected and
# then REFUSED rather than permitted. That asymmetry is the whole fix: folding
# the allowlist too would reopen the hole from the other side.
#
# GAP 3 — WHY THE RC IS CAPTURED WITH if/else. `set -e` is on at line 17 but
# `pipefail` was not, and the pipeline ended in `|| true`. A git failure — a
# corrupt index, a killed process — produced an empty capture indistinguishable
# from "nothing staged", and the gate PERMITTED. `|| true` also clobbers
# PIPESTATUS to `(0)`, and PIPESTATUS does not survive `$( )` anyway, so it
# could not have been recovered. `set -o pipefail` DOES propagate into `$( )`,
# so the status is now captured with the same if/else shape used at the pytest
# gate below, and any non-zero status REFUSES. The scope is the five lines
# around the capture, turned straight back off so the pipeline further down
# this file is untouched.
#
# WHY R/C RECORDS CONSUME A SECOND PATH. `--raw -z` emits ONE NUL-terminated
# metadata field followed by the path, and a SECOND path ONLY for rename/copy
# statuses. There is no disambiguating NUL before path1, so the second path
# must be consumed BEFORE any `continue`: a skip that left path2 in the stream
# would have it misread as the NEXT record's metadata, silently dropping a
# genuinely staged path. That exact desync already bit this repo once and is
# written up at plugins/autonomous-dev/lib/git_operations.py:532-541. The path
# this gate checks for a rename is the DESTINATION.
#
# The selector deliberately stays a PREFIX match (case-folded): it decides
# which staged paths are in this gate's domain, not which are allowed. Two of
# the three allowlist entries have `!` negations at .gitignore:147-148
# excepting them from the `.claude/*` blanket at :146, and must agree with it;
# cloud-runs.jsonl has NO negation and needs none — it is already tracked, and
# gitignore does not apply to tracked files. Its absence is not a disagreement.
#
# Why each allowlisted path is tracked:
#   .claude/PROJECT.md    120000  symlink to root PROJECT.md (alignment source
#                                 of truth) — tracked ONLY as a symlink.
#   .claude/settings.json 100644  committable team settings; the separate
#                                 `.claude/settings.local.json` was merged into
#                                 it and deleted 2026-09-03.
#   .claude/logs/cloud-runs.jsonl 100644
#                                 auto-appended cloud-drain telemetry; master
#                                 commits it on every fire — bypassing this hook
#                                 with --no-verify was the prior workaround.
# The two `100644` entries are tracked ONLY as regular files: either of them
# staged as a symlink is refused, which is the exploit this pairing closes.
#
# Reads `git diff --cached --raw -z` on stdin and prints one `<path> <mode>`
# line per offending staged path. Returns 3, never a partial answer, on any
# stream it cannot account for.
claude_gate_scan() {
    local IFS=' '
    local meta path dest newmode status entry
    local -a fields
    while true; do
        meta=''
        if ! IFS= read -r -d '' meta; then
            if [ -n "$meta" ]; then
                return 3
            fi
            return 0
        fi
        if ! IFS= read -r -d '' path; then
            return 3
        fi
        fields=( $meta )
        newmode=${fields[1]}
        status=${fields[4]}
        case "$newmode" in
            [0-7][0-7][0-7][0-7][0-7][0-7]) ;;
            *) return 3 ;;
        esac
        if [ -z "$status" ]; then
            return 3
        fi
        case "$status" in
            R*|C*)
                if ! IFS= read -r -d '' dest; then
                    return 3
                fi
                path="$dest"
                ;;
        esac
        if [ "$newmode" = "000000" ]; then
            continue
        fi
        case "$path" in
            .[Cc][Ll][Aa][Uu][Dd][Ee]/*) ;;
            *) continue ;;
        esac
        entry="$path $newmode"
        case "$entry" in
            ".claude/PROJECT.md 120000") continue ;;
            ".claude/settings.json 100644") continue ;;
            ".claude/logs/cloud-runs.jsonl 100644") continue ;;
        esac
        printf '%s %s\n' "$path" "$newmode"
    done
}

set -o pipefail
if CLAUDE_STAGED_FILES=$(git diff --cached --raw -z | claude_gate_scan); then
    CLAUDE_SCAN_RC=0
else
    CLAUDE_SCAN_RC=$?
fi
set +o pipefail

if [ "$CLAUDE_SCAN_RC" -ne 0 ]; then
    echo ""
    echo "❌ ERROR: the .claude/ staging gate could not read the index."
    echo ""
    echo "The scan exited $CLAUDE_SCAN_RC. This gate fails CLOSED: it refuses a"
    echo "commit it was unable to inspect rather than permitting one it never"
    echo "actually checked. Exit 3 means the --raw -z record stream was"
    echo "malformed; any other status came from git itself (a corrupt index, a"
    echo "killed process, a repository it could not open)."
    echo ""
    echo "REQUIRED NEXT ACTION — reproduce and read the raw stream:"
    echo "  git diff --cached --raw -z | od -c | head"
    echo ""
    echo "Then repair the index (git reset, git fsck) and commit again."
    exit 1
fi

if [ -n "$CLAUDE_STAGED_FILES" ]; then
    echo ""
    echo "❌ ERROR: Attempting to commit .claude/ files (should be gitignored):"
    echo "$CLAUDE_STAGED_FILES"
    echo ""
    echo "Listed above as '<path> <staged git mode>'. Everything else under"
    echo ".claude/ is generated/installed. Exactly three (path, mode) pairs are"
    echo "tracked:"
    echo "  .claude/PROJECT.md 120000            (symlink to the root PROJECT.md)"
    echo "  .claude/settings.json 100644         (regular file)"
    echo "  .claude/logs/cloud-runs.jsonl 100644 (regular file)"
    echo "The match is exact (whole-line), so .claude/settings.json.bak is NOT"
    echo "allowed, and neither is .claude/settings.json staged as a symlink."
    echo "The .claude/ prefix is matched case-insensitively; the allowlist is not."
    echo ""
    echo "To fix:"
    echo "  git reset HEAD .claude/  # Unstage these files"
    echo "  git status --ignored     # Verify they're ignored"
    echo ""
    echo "To bypass (NOT recommended): git commit --no-verify"
    exit 1
fi

echo "🔍 Validating slash command implementations..."

# Run command validation (archived hook, still useful for pre-commit)
if [ -f "plugins/autonomous-dev/hooks/archived/validate_commands.py" ]; then
    python3 plugins/autonomous-dev/hooks/archived/validate_commands.py
fi

echo "🔍 Syncing install manifest with source files..."

# Auto-sync install_manifest.json (archived hook, still useful for pre-commit)
if [ -f "plugins/autonomous-dev/hooks/archived/validate_install_manifest.py" ]; then
    python3 plugins/autonomous-dev/hooks/archived/validate_install_manifest.py
    MANIFEST_EXIT=$?
    if [ $MANIFEST_EXIT -ne 0 ]; then
        echo ""
        echo "⚠️  Manifest sync failed. Check output above."
        exit $MANIFEST_EXIT
    fi
fi

# If manifest was updated, stage it
if git diff --name-only | grep -q "install_manifest.json"; then
    echo "📦 Manifest updated - auto-staging..."
    git add plugins/autonomous-dev/config/install_manifest.json
fi

echo "🔍 Validating settings template hooks exist..."

# Ensure hooks referenced in settings template actually exist
if [ -f "plugins/autonomous-dev/hooks/archived/validate_settings_hooks.py" ]; then
    python3 plugins/autonomous-dev/hooks/archived/validate_settings_hooks.py
    SETTINGS_EXIT=$?
    if [ $SETTINGS_EXIT -ne 0 ]; then
        echo ""
        echo "⚠️  Settings template references missing hooks. Fix before committing."
        exit $SETTINGS_EXIT
    fi
fi

echo "🔍 Validating library imports..."

# Ensure all lib imports resolve (catches deleted/renamed libs)
if [ -f "plugins/autonomous-dev/hooks/archived/validate_lib_imports.py" ]; then
    python3 plugins/autonomous-dev/hooks/archived/validate_lib_imports.py
    IMPORTS_EXIT=$?
    if [ $IMPORTS_EXIT -ne 0 ]; then
        echo ""
        echo "⚠️  Broken library imports detected. Fix before committing."
        exit $IMPORTS_EXIT
    fi
fi

echo "🔍 Validating all hooks documented..."

# Ensure all hooks have documentation in HOOKS.md
if [ -f "plugins/autonomous-dev/hooks/archived/validate_hooks_documented.py" ]; then
    python3 plugins/autonomous-dev/hooks/archived/validate_hooks_documented.py
    DOCS_EXIT=$?
    if [ $DOCS_EXIT -ne 0 ]; then
        echo ""
        echo "⚠️  New hooks need documentation. Add to docs/HOOKS.md before committing."
        exit $DOCS_EXIT
    fi
fi

echo "🔍 Running documentation validation tests..."

# Select a pytest. Capture with if/else, never `|| true`: under `set -e`
# (line 17) a bare `cmd; rc=$?` aborts before the message prints, and
# `cmd || true` makes the capture unconditionally 0 — the defect that
# left this gate unable to refuse for 9.5 months (introduced 0b00185f).
if [ -f "venv/bin/pytest" ]; then
    PYTEST_BIN="venv/bin/pytest"
elif command -v pytest &> /dev/null; then
    PYTEST_BIN="pytest"
else
    PYTEST_BIN=""
fi

if [ -z "$PYTEST_BIN" ]; then
    echo "⚠️  pytest not installed — documentation tests DID NOT RUN."
    echo "   This commit was not checked. Install:"
    echo "     python3 -m venv venv && venv/bin/pip install pytest"
else
    # stderr is deliberately NOT discarded: the previous `2>/dev/null` threw
    # away the diagnostic a blocked committer needs, and would hide a
    # collection error as a silent pass.
    if "$PYTEST_BIN" tests/integration/test_documentation_references.py -q --tb=line; then
        TEST_EXIT=0
    else
        TEST_EXIT=$?
    fi
    if [ $TEST_EXIT -ne 0 ]; then
        echo ""
        echo "❌ Documentation tests failed — commit blocked."
        echo ""
        echo "REQUIRED NEXT ACTION — reproduce and fix:"
        echo "  $PYTEST_BIN tests/integration/test_documentation_references.py -q"
        echo ""
        echo "These check docs/{LIBRARIES,PERFORMANCE,GIT-AUTOMATION}.md and"
        echo "CLAUDE.md for broken links, dead heading anchors, and absolute"
        echo "paths outside code fences. A failure means a link or path you"
        echo "touched no longer resolves."
        exit $TEST_EXIT
    fi
fi

# If all validations pass, allow commit
exit 0
